// Prisma schema for Garage.
//
// This file mirrors the contract's entity schemas
// (`libs/garage/contract/src/schemas/entities.ts`) field for field: same names, same
// nullability, same enum members. The contract is the single source of truth for
// data shapes; where storage has to differ, the difference is deliberate and
// documented in `doc/database.md` (§"Where storage differs from the contract").
//
// Connection URLs live in `prisma.config.ts` at the repo root — Prisma 7
// deprecated `url` in the datasource block.

generator client {
  provider = "prisma-client"

  // Prisma 7 requires an explicit output; the client is no longer written into
  // node_modules. It lands inside this lib so it is versioned with the schema
  // that produced it and is reachable from `@garage/database`.
  output = "../src/generated/prisma"

  // The whole backend (apps/garage/api, Jest via ts-jest) is CommonJS, so the
  // generated client has to be too — the default is ESM.
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// --- Enumerations ----------------------------------------------------------
// Members must stay identical to the tuples in
// `libs/garage/shared-types/src/lib/domain-constants.ts`, which the contract's Zod
// enums are built from. `libs/garage/database/src/lib/schema-contract-parity.spec.ts`
// (describe: "Prisma enums mirror the domain enumerations") fails if they drift.

/// Parking spot group. IT spots are reserved for the IT department.
enum ParkingGroup {
  IT
  SHARED
}

/// Application role. There are exactly two; there is no per-resource ACL.
enum UserRole {
  USER
  ADMIN
}

/// Admin override of the reservation window (see decision 0004).
enum ReservationLockMode {
  AUTO
  FORCE_OPEN
  FORCE_LOCKED
}

/// Closed list of audited actions (see decision 0016).
enum AuditLogAction {
  RESERVATION_CREATED
  RESERVATION_CANCELLED
  RESERVATION_CANCELLED_BY_ADMIN
  WAITLIST_PROMOTED
  USER_UPDATED
  SPOT_UPDATED
  RESERVATION_WINDOW_UPDATED
  WAITLIST_JOINED
  RESERVATION_CREATED_BY_ADMIN
  WAITLIST_JOINED_BY_ADMIN
  RESERVATION_LIMITS_UPDATED
  TIMED_RESERVATION_CREATED
  TIMED_RESERVATION_CANCELLED
}

// --- Entities --------------------------------------------------------------

/// An employee. Offboarding deactivates a user (`active = false`) instead of
/// deleting the row, so foreign keys from reservations and the audit log stay
/// intact.
model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  email        String   @unique
  name         String
  /// Czech licence plate ("SPZ"); optional, used to identify a parked car.
  licensePlate String?
  role         UserRole @default(USER)
  /// Subject claim of the Okta token; the identity we provision against.
  oktaId       String   @unique
  active       Boolean  @default(true)
  /// Secret in the personal ICS feed URL; regenerating it invalidates the old URL.
  icsToken     String   @unique

  /// First choice when bulk booking. Never applied to a single-day reservation.
  /// Nullable FK: retiring a spot must not delete or block the user.
  preferredParkingSpotId String?      @db.Uuid
  preferredParkingSpot   ParkingSpot? @relation("UserPreferredSpot", fields: [preferredParkingSpotId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  reservations    Reservation[]
  waitlistEntries WaitlistEntry[]
  auditLogs       AuditLog[]

  @@index([preferredParkingSpotId])
}

/// A physical parking spot. Retired spots are deactivated rather than deleted,
/// for the same foreign-key reason as users.
model ParkingSpot {
  id        String       @id @default(uuid(7)) @db.Uuid
  /// Label painted on the spot, e.g. `E2.92`. Unique across the lot.
  label     String       @unique
  group     ParkingGroup
  active    Boolean      @default(true)
  /// Seen and booked by admins only (`doc/decision/0316-hidden-spots-are-seen-and-booked-by-admins-only`).
  /// Not a retirement: a hidden spot stays bookable by an admin, for anybody.
  hidden    Boolean      @default(false)
  /// Has a charger for electric cars. Informational only, shown to everybody
  /// (`doc/decision/0317-the-ev-charger-flag-is-informational-and-shown-to-everyone`).
  evCharger Boolean      @default(false)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @db.Timestamptz(3)

  reservations      Reservation[]
  waitlistEntries   WaitlistEntry[]
  timedReservations TimedReservation[]
  preferredBy       User[]             @relation("UserPreferredSpot")
}

/// One spot booked for one day, by exactly one holder: a user, or a guest.
///
/// The two unique constraints are the concurrency guarantee of the whole
/// reservation flow: `(parkingSpotId, date)` is what makes double-booking
/// impossible under concurrent requests, and Task 10 maps its `P2002` violation
/// onto the contract error `SPOT_ALREADY_RESERVED`.
///
/// `userId` is nullable so that an admin can book for a guest, who has no `User`
/// row. `Reservation_holder_check` is what keeps that from admitting a row with
/// no holder at all — see `doc/decision/0305-a-reservation-holder-is-a-user-or-a-guest-never-neither`. Because `NULL`s do not collide
/// in a Postgres unique index, `(userId, date)` still means "one reservation per
/// user per day" and deliberately does not limit guests.
model Reservation {
  id            String   @id @default(uuid(7)) @db.Uuid
  parkingSpotId String   @db.Uuid
  userId        String?  @db.Uuid
  /// Set only for a guest reservation.
  guestName     String?
  /// Overrides the holder's stored plate for this day only; the only plate a
  /// guest can have.
  licensePlate  String?
  /// Reservation day in Europe/Prague. `DATE`, never a timestamp.
  date          DateTime @db.Date
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  parkingSpot ParkingSpot @relation(fields: [parkingSpotId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user        User?       @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([parkingSpotId, date])
  @@unique([userId, date])
  @@index([date])
}

/// A guest booked into a half-hour-granular block of one day, on one spot.
///
/// A separate model from `Reservation`, not a variant of it: a timed block is
/// always for a guest (no `userId`) and a spot may hold many of them on one
/// day, whereas `Reservation` is one-per-spot-per-day. Storage is minutes
/// since local midnight (`[startMinute, endMinute)`, half-open, multiples of
/// 30, `endMinute` up to `1440`), not the contract's `HH:MM` strings — see
/// `doc/database.md` (§"Where storage differs from the contract").
///
/// One (spot, day) is either one full-day `Reservation` or any number of
/// non-overlapping `TimedReservation` blocks, never both. Prisma's schema
/// language cannot express that exclusivity rule or the half-open-range
/// `CHECK`, so both live in the migration as hand-written SQL: a `CHECK` on
/// this table and a pair of triggers spanning both tables. See
/// `doc/decision/0314-*`.
model TimedReservation {
  id            String   @id @default(uuid(7)) @db.Uuid
  parkingSpotId String   @db.Uuid
  /// Reservation day in Europe/Prague. `DATE`, never a timestamp.
  date          DateTime @db.Date
  /// Minutes after local midnight, inclusive. Multiple of 30.
  startMinute   Int      @db.SmallInt
  /// Minutes after local midnight, exclusive. Multiple of 30; 1440 = midnight.
  endMinute     Int      @db.SmallInt
  guestName     String
  licensePlate  String?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  parkingSpot ParkingSpot @relation(fields: [parkingSpotId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([parkingSpotId, date])
  @@index([date])
}

/// A user waiting for an already-booked spot on a given day. Queue order is
/// `createdAt`, with `id` as the tiebreaker.
model WaitlistEntry {
  id            String   @id @default(uuid(7)) @db.Uuid
  parkingSpotId String   @db.Uuid
  userId        String   @db.Uuid
  /// Reservation day in Europe/Prague. `DATE`, never a timestamp.
  date          DateTime @db.Date
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  parkingSpot ParkingSpot @relation(fields: [parkingSpotId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([parkingSpotId, userId, date])
  @@index([date])
  /// Covers the "who is next in line for this spot on this day" read.
  @@index([parkingSpotId, date, createdAt, id])
}

/// Append-only audit trail. Cancelling a reservation is a hard delete plus an
/// audit entry, so this table is what preserves the history. `UPDATE` and
/// `DELETE` are rejected by a database trigger created in the init migration.
model AuditLog {
  id          String         @id @default(uuid(7)) @db.Uuid
  /// Who performed the action. System actions are attributed to their trigger.
  actorUserId String         @db.Uuid
  action      AuditLogAction
  /// Entity kind the action applied to, e.g. `Reservation`.
  entityType  String
  entityId    String
  /// Free-form JSONB detail; its shape depends on `action`.
  payload     Json           @db.JsonB
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)

  // `onUpdate: Cascade` here is Prisma's default and it contradicts the
  // append-only trigger: a cascade fires `UPDATE "AuditLog"`, which
  // `auditlog_reject_mutation()` aborts, taking the whole transaction with it.
  // Left as Cascade on purpose. `User.id` is `@default(uuid(7))` and no code
  // path in this application updates a primary key, so the cascade is
  // unreachable; changing it to `NoAction` would be a truer declaration but
  // needs a fourth migration altering the constraint, and applying that to the
  // shared development database mid-review would desynchronise every other
  // worktree's migration history for a contradiction nothing can reach. Final
  // review M-4; recorded in
  // doc/decision/0278-auditlog-actor-keeps-prismas-default-on-update.md.
  actor User @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([createdAt])
  @@index([actorUserId])
  @@index([entityType, entityId])
}

/// Singleton settings row driving the reservation window (decision 0004).
///
/// `id` is a fixed `Int`, not a UUID, and never leaves the database: the
/// contract's `reservationWindowSettingsSchema` has no `id` field at all. The
/// single-row property is enforced by `CHECK ("id" = 1)`, added by hand to the
/// init migration — Prisma's schema language cannot express a CHECK constraint.
/// See `doc/database.md` and `doc/decision/0026-*`.
model ReservationWindowSettings {
  id Int @id @default(1)

  /// How many days before the first of a month the month opens for booking.
  /// `CHECK` in the migration mirrors the contract's 1–31 bounds.
  openDaysBefore Int                 @default(7)
  /// Admin override of the automatic window.
  lockMode       ReservationLockMode @default(AUTO)

  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

/// Singleton settings row holding the reservation limits (TODO item 2).
///
/// Separate from `ReservationWindowSettings` rather than a column on it: that
/// model drives the *window* — whether a month is open to anybody — and a
/// per-user monthly quota is a different rule with a different audience. Its
/// name and doc comment say so, and a column that made both false is the kind
/// of defect this repo treats as real. Renaming that model instead would have
/// dragged `AuditLog.entityType` and `action` string values with it, leaving
/// the append-only audit table permanently disagreeing with itself.
/// See `doc/decision/0312-*`.
///
/// Same singleton arrangement as its neighbour: `id` is a fixed `Int`, never
/// leaves the database (the contract's `reservationLimitSettingsSchema` has no
/// `id` field), and the single-row property is a `CHECK ("id" = 1)` added by
/// hand in the migration, because Prisma's schema language cannot express a
/// CHECK. See `doc/database.md` and `doc/decision/0026-*`.
model ReservationLimitSettings {
  id Int @id @default(1)

  /// How many confirmed reservations one user may hold in a calendar month.
  /// `CHECK` in the migration mirrors the contract's 1–31 bounds.
  monthlyReservationCap Int @default(5)

  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}
